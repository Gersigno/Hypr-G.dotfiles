{
    "layer": "top",
    "position": "top",
    "margin-top": 8,
    "margin-left": 8,
    "margin-right": 8,
    "reload_style_on_change": true,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window",
        "mpris"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "group/expand-tray",
        "group/expand-system",
        "group/expand-audio",
        "group/expand-brightness",
        "network",
        "battery"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "default": "○",
            "active": "●"
        }
    },

    "hyprland/window": {
        "format": "<span weight='bold'>{initialTitle}</span>",
        "max-length": 120,
        "icon": false,
        "tooltip": false
    },

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "<span color='grey'>{status_icon} {dynamic}</span>",
        "max-length": 50,
        "player-icons": {
            "default": "⏸",
            "mpv": "🎵"
        },
        "status-icons": {
            "paused": "▶"
        }
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%b %d, %H:%M}",
        "tooltip-format": "{:%A, %B %d, %Y - %H:%M:%S}"
    },

    "group/expand-tray": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 600,
            "children-class": "not-power",
            "transition-to-left": true,
            "click-to-reveal": true
        },
        "modules": [
            "custom/menu",
            "tray"
        ]
    },

    "custom/menu": {
        "tooltip": false,
        "format": "󰍜"
    },

    "tray": {
        "icon-size": 14,
        "rotate": 0
    },

    "group/expand-system": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 600,
            "children-class": "not-power",
            "transition-to-left": true,
            "click-to-reveal": true
        },
        "modules": [
            "custom/system-info-button",
            "memory",
            "cpu",
            "temperature"
        ]
    },

    "custom/system-info-button": {
        "format": "",
        "tooltip": true,
        "tooltip-format": "System informations"
    },
    
    "memory": {
        "interval": 1,
        "rotate": 0,
        "format": "<span>󰍛 {percentage}%</span>",
        "opaci": 0,
        "format-icons": [
            "󰝦",
            "󰪞",
            "󰪟",
            "󰪠",
            "󰪡",
            "󰪢",
            "󰪣",
            "󰪤",
            "󰪥"
        ],
        "max-length": 10,
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB"
    },

    "cpu": {
        "interval": 1,
        "format": "<span>󰻠 {usage}%</span>",
        "rotate": 0,
        "format-icons": [
            "󰝦",
            "󰪞",
            "󰪟",
            "󰪠",
            "󰪡",
            "󰪢",
            "󰪣",
            "󰪤",
            "󰪥"
        ],
        "tooltip-format": "CPU: {usage}%",
        "tooltip": true
    },
    
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
        "format": "<span>󰔐 {temperatureC}°C</span>",
        "critical-threshold": 80,
        "format-critical": "󰔑 {temperatureC}°C",
        "tooltip": true,
        "tooltip-format": "Temperature: {temperatureC}°C"
    },

    "network": {
        "tooltip": true,
        "format-wifi": "{icon}",
        "format-icons": [
            "󰤟",
            "󰤢",
            "󰤥"
        ],
        "format-ethernet": "󰈀",
        "tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>",
        "format-linked": "󰈀< {ifname} (No IP)",
        "format-disconnected": "",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 8
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon}",
        "format-charging": "<span color='#a6d189'>󱐋</span>",
        "format-plugged": "󰂄",
        "format-alt": "<span weight='bold' color='#c2864a'>{time} <span weight='bold' color='white'>| <span weight='bold' color='#82d457'>{capacity}%</span></span></span>",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "on-click-right": "pkill waybar & hyprctl dispatch exec waybar"
    },

    "group/expand-audio": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 600,
            "children-class": "not-power",
            "transition-to-left": true,
            "click-to-reveal": true
        },
        "modules": [
            "custom/audio-button",
            "pulseaudio/slider",
            "custom/audio-settings"
        ]
    },

    "custom/audio-button": {
        "format": "󰕾",
        "tooltip": false
    },
    "custom/audio-settings": {
        "format": "",
        "tooltip": false,
        "on-click": "pavucontrol"
    },

    "pulseaudio/slider": {
        "format": "",
        "min": 0,
        "max": 100,
        "orientation": "horizontal",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
    },

    "group/expand-brightness": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 600,
            "children-class": "not-power",
            "transition-to-left": true,
            "click-to-reveal": true
        },
        "modules": [
            "custom/brightness-button",
            "backlight/slider",
            "custom/dark-light"
        ]
    },

    "custom/brightness-button": {
        "format": "󰃟",
        "tooltip": false,
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "backlight/slider": {
        "format": "",
        "min": 0,
        "max": 100,
        "orientation": "horizontal",
        "device": "intel_backlight",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "custom/dark-light": {
        "tooltip": true,
        "tooltip-format": "Switch to light/dark mode",
        "format": "󰔎",
        "on-click": "~/.config/hypr/hypr-g/scripts/toggle-theme.sh" 
    }
}