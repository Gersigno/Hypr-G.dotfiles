/*

# Top level files
!.gitignore
!README.md

# Top level directories
!fastfetch/
!fish/
!hypr/
hypr/custom/
!kitty/
!xdg-desktop-portal/
!matugen/
!rofi/
!quickshell/

!yazi/

# Explicitly re-excluded files (has to include each parent directories)
!/hypr/
!/hypr/hypr-g/
!/hypr/hypr-g/hyprlock/
/hypr/hypr-g/hyprlock/wallpaper.png

# Ignore fish_variables and all its variants
fish/fish_variables
fish/fish_variables*
fish/completions/copilot.fish

# Ignore color schemes generated by matugen
hypr/hypr-g/hyprland/colors.lua
hypr/hypr-g/hyprlock/colors.conf
kitty/colors.conf
rofi/colors.rasi
quickshell/colors.json
quickshell/settings.json
yazi/flavors/
kdeglobals


# Exclude cache and generated files
**/.cache/
**/cache/
**/*.log
**/*.swp
**/*~
