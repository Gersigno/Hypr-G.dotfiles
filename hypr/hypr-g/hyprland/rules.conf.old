# Ignore maximize requests from apps. You'll probably like this.
windowrule = suppress_event maximize, match:class .*

# Fix some dragging issues with XWayland
windowrule = no_focus on, match:class ^$, match:title ^$, match:xwayland 1, match:float 1, match:fullscreen 0, match:pin 0

# Persistent workspaces per monitor
# Monitor 1 (eDP-1) - workspaces 1-4
workspace = 1, monitor:eDP-1, persistent:true
workspace = 2, monitor:eDP-1, persistent:true
workspace = 3, monitor:eDP-1, persistent:true
workspace = 4, monitor:eDP-1, persistent:true

#windowrule = idle_inhibit focus, match:fullscreen

layerrule = match:namespace waybar, blur on
layerrule = match:namespace waybar, ignore_alpha 0
layerrule = match:namespace rofi, blur on
layerrule = match:namespace rofi, ignore_alpha 0
layerrule = match:namespace fuzzel, blur on

# Notification center blur (thanks to zDyant https://github.com/zDyant)
layerrule = match:namespace swaync-control-center, blur on
layerrule = match:namespace swaync-notification-window, blur on
layerrule = match:namespace swaync-control-center, ignore_alpha 0
layerrule = match:namespace swaync-notification-window, ignore_alpha 0
layerrule = match:namespace swaync-control-center, ignore_alpha 0.5
layerrule = match:namespace swaync-notification-window, ignore_alpha 0.5

layerrule = match:namespace swaync-control-center, animation slide right

# Control Center blur and opacity
layerrule = match:namespace quickshell:notificationsCenter, blur on
layerrule = match:namespace quickshell:notificationsCenter, ignore_alpha 0.79
layerrule = match:namespace quickshell:notificationsCenter, no_anim on

#Top bar animation
#layerrule = match:namespace quickshell:topBar, no_anim on
layerrule = match:namespace quickshell:topBar, animation slide down

# Notification popup blur and opacity
layerrule = match:namespace quickshell:notificationPopup, blur on
layerrule = match:namespace quickshell:notificationPopup, ignore_alpha 0.79
layerrule = match:namespace quickshell:notificationPopup, animation fade

layerrule = match:namespace selection, no_anim on
layerrule = match:namespace swappy, no_anim on
layerrule = match:namespace hyprshot, no_anim on
layerrule = match:namespace quickshell:notifications, no_anim on

# Toast notifications blur and opacity
layerrule = match:namespace quickshell:toast, blur on
layerrule = match:namespace quickshell:toast, ignore_alpha 0.79
layerrule = match:namespace quickshell:toast, animation fade